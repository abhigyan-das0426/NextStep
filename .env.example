# NextStep Environment Variables
# Copy this file to .env.local to configure a live AI model.
# If no keys are provided, NextStep automatically runs in Demo Mode (deterministic offline engine).

# Google Gemini API Key (Recommended)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# OR OpenAI API Key
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: Live Google OAuth 2.0 (for /login "Continue with Google")
# Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
